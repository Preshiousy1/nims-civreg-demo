PORT=3042
# Local compose maps Postgres to host 5433. In Docker the hostname is postgres:5432.
DATABASE_URL=postgres://civreg:civreg@localhost:5433/civreg
RUN_MIGRATIONS=true
STUB_IDENTITY_URL=http://localhost:3041
STUB_RETRY_ATTEMPTS=3
STUB_RETRY_DELAY_MS=200
# DEMO system client. Same values as countryconfig CIVREG_BRIDGE_CLIENT_*.
OPENCRVS_TOKEN_URL=http://gateway.opencrvs.localhost/auth/token
OPENCRVS_EVENTS_URL=http://gateway.opencrvs.localhost/events
OPENCRVS_CLIENT_ID=a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d
OPENCRVS_CLIENT_SECRET=demo-civreg-bridge-not-a-real-secret
# Host: localhost:9092. Inside compose: broker:19092. Empty skips publish.
KAFKA_BROKERS=localhost:9092
# DEMO only. Stands in for Keycloak OIDC. Not a production secret.
JWT_SECRET=demo-civreg-jwt-not-a-real-secret
