{
  "name": "civreg-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "DEMO civil-registration bridge. Does not call OpenCRVS or Kafka in Prompt 8.",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": "22.x.x"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "tsc --noEmit -p tsconfig.build.json",
    "test": "jest",
    "test:ci": "jest --testPathIgnorePatterns=integration",
    "test:watch": "jest --watch",
    "migration:run": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:run",
    "migration:run:prod": "node dist/database/run-migrations.js",
    "migration:revert": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:revert"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/typeorm": "11.0.3",
    "@opencrvs/toolkit": "2.1.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "jsonwebtoken": "9.0.2",
    "kafkajs": "2.2.4",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.18.8",
    "jest": "29.7.0",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.5.0",
      "js-yaml": ">=4.3.2",
      "picomatch": ">=4.0.4"
    }
  }
}
